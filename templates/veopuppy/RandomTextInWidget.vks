var group_id = 139618442; // Укажите id вашей группы!

var user = API.users.get({"user_ids":Args.uid,"fields":"timezone,last_seen"})[0];

// === Случайность: время последнего визита посетителя ===
var base = user.last_seen.time;
var rnd_values = [ ((base * 9301 + 49297) % 233280) / 233280, ((base * 49297 + 9301) % 233280) / 233280 ];

// === Темы ===

// === Активность участников: лайки и комментарии ===
var engagement = [
    {"title":"Хотите поддержать обсуждение?","text":"Поставьте лайк или напишите комментарий о щенках ВЕО."},
    {"title":"Хотите поделиться опытом?","text":"Расскажите о своем питомце или задайте вопрос другим участникам."},
    {"title":"Обсудим щенков ВЕО?","text":"Ваш комментарий важен для группы."},
    {"title":"Хотите, чтобы ваш пост заметили?","text":"Лайк и комментарий помогут другим участникам обратить внимание на объявление."},
    {"title":"Хотите больше лайков и комментариев?","text":"Активность помогает другим участникам заметить ваши посты."}
];

// === Сообщения о продаже/покупке щенков ===
var sales = [
    {"title":"Ищете щенка ВЕО?","text":"Смотрите свежие объявления о продаже щенков."},
    {"title":"Хотите купить щенка?","text":"Обратите внимание на новые публикации в группе."},
    {"title":"Интересуют новые предложения?","text":"Следите за обновлениями и находите питомца."}
];

// === Призыв к активности в группе ===
var group_invite = [
    {"title":"Хотите быть активным участником?","text":"Вступайте в группу, публикуйте объявления и общайтесь с владельцами ВЕО."},
    {"title":"Хотите больше лайков и комментариев?","text":"Активность помогает другим участникам заметить ваши посты."}
];

// === Информационные сообщения (правила и оформление объявлений) ===
var info = [
    {"title":"Какие правила публикации?","text":"Указывайте город, организацию, дату рождения, окрас и пол щенков."},
    {"title":"Нужны ли фото и видео?","text":"Прикрепляйте качественные фото и видео щенков."},
    {"title":"Как указать цену щенка?","text":"По возможности укажите вилку цен в объявлении."},
    {"title":"Бесплатна ли публикация?","text":"Размещение объявлений бесплатно только для щенков ВЕО с документально подтвержденным происхождением."},
    {"title":"Что указать в объявлении о покупке?","text":"Указывайте город, возраст, пол и цель покупки щенка."},
    {"title":"Как проверить актуальность объявления?","text":"Если объявление не актуально, отметьте это в комментариях."},
    {"title":"Что делать после публикации?","text":"Сделайте репост объявления на своей странице."},
    {"title":"Какие поля обязательны?","text":"Город, организация, дата рождения, окрас и пол — обязательно."},
    {"title":"Нужно ли указывать родителей?","text":"Укажите клички родителей. Фото и видео — по возможности."},
    {"title":"Как оформить публикацию правильно?","text":"Объявление должно быть кратким, информативным и понятным."},
    {"title":"Что проверить перед публикацией?","text":"Убедитесь, что все поля заполнены и фото/видео добавлены."},
    {"title":"Какие платные услуги доступны?","text":"Закреп, репост и закрытие комментариев оформляются отдельно."},
    {"title":"Где узнать критерии публикаций?","text":"Подробно описаны в статье группы.","button":"Читать статью","button_url":"https://vk.ru/@veopuppy-posting-rules"},
    {"title":"Как правильно оформлять объявления?","text":"В статье группы подробно описаны критерии публикаций.","button":"Ознакомиться","button_url":"https://vk.ru/@veopuppy-posting-rules"},
    {"title":"Где почитать правила оформления?","text":"Читайте статью, чтобы узнать правила оформления объявлений.","button":"Посмотреть статью","button_url":"https://vk.ru/@veopuppy-posting-rules"},
    {"title":"Какие инструкции доступны?","text":"Подробная инструкция доступна в статье группы.","button":"Читать инструкцию","button_url":"https://vk.ru/@veopuppy-posting-rules"}
];

// === Проверка членства ===
var is_member = API.groups.isMember({"group_id":group_id,"user_id":Args.uid});

// === Случайный выбор темы через rnd_values[0] ===
var chosen_topic;

if (!is_member) {
    // Не в группе: доступны только info и group_invite
    if (rnd_values[0] <= 0.6) chosen_topic = info;    // 60% — общие сообщения
    else chosen_topic = group_invite;                // 40% — призыв вступить
} else {
    // В группе: доступны все темы
    if (rnd_values[0] <= 0.3) chosen_topic = engagement; // 30%
    else if (rnd_values[0] <= 0.6) chosen_topic = sales; // 30%
    else chosen_topic = info;                             // 40%
}

// === Выбор случайного сообщения из выбранной темы через rnd_values[1] ===
// Дробная часть отбрасывается: у каждого сообщения темы равная доля, а при rnd < 1 индекс не выходит за длину
var msg_index = parseInt(rnd_values[1] * chosen_topic.length);

var stub_item = {
    "title": "Рады Вас видеть",
    "button": "",
    "button_url": "",
    "text": "Приятного просмотра!"
};

var result_item = stub_item + {"icon_id": "club" + group_id} + chosen_topic[msg_index];

// === Заглушка приветствия пользователя ===
var greeting = "Доброго времени суток, ";
if (user.timezone) {
    var time = (parseInt((user.last_seen.time % 86400) / 3600) + user.timezone) % 24;
    if (time < 6) greeting = "Доброй ночи, ";
    else if (time < 12) greeting = "Доброе утро, ";
    else if (time < 18) greeting = "Добрый день, ";
    else greeting = "Добрый вечер, ";
}

var smart_title = greeting + user.first_name + "!";

// === Возврат ===
return {
    "title":smart_title,
    "rows":[result_item]
};